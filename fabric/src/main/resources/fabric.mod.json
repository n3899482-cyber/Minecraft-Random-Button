{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "version": "${mod_version}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "icon.png",
  "entrypoints": {
    "main": [
      "com.nzoros.randombutton.MyModFabric"
    ],
    "client": [
      "com.nzoros.randombutton.MyModFabricClient"
    ]
  },
  "mixins": [
    "randombutton.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": "*"
  }
}
